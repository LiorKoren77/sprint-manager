# Sprint Manager credentials — copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is loaded automatically at startup (see scripts/sprint_manager/config.py) and is
# gitignored, so it's safe to put real secrets here. A real shell-exported environment variable
# always takes precedence over .env, so this is purely a local convenience.
#
# You can also fill these in from the running app: ⚙ Settings → Credentials.
#
# WHICH variables a project needs is set by its profile (~/.config/sprint-manager/projects/<name>/
# project.toml): [jira] email_env / token_env and [ci] user_env / token_env name them. The
# defaults are below; a profile may point at differently-named variables instead.

# --- Jira + Confluence (only for projects whose profile has a [jira] table) ---
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jenkins (only for projects with [ci] provider = "jenkins") ---
JENKINS_USER=
JENKINS_API_TOKEN=

# --- Slack (optional — lets any stage fetch a linked thread for context) ---
# Bot token from a Slack app installed to the workspace, scoped to channels:history,
# groups:history, users:read, channels:read (add groups:read for private channels).
SLACK_BOT_TOKEN=

# --- Not env vars — separate interactive logins, checked but not set here ---
# GitHub CLI:      gh auth login
# Claude account:  claude   (then /login)
